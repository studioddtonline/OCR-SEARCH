{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "allowJs": true,
    "checkJs": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mts",
    "test/**/*.ts",
    "test/**/*.mts"
  ],
  "exclude": ["node_modules", "dist"]
}
