{
  "name": "ocr-search",
  "version": "0.1.0",
  "private": true,
  "description": "Shared OCR search engine for Node.js consumers",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-runtime-assets.mjs",
    "prepack": "npm run build",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "japanese-index": "node scripts/build-japanese-index.mjs",
    "japanese-extension:install": "bash scripts/install-sqlite-vaporetto.sh",
    "japanese-extension:check": "node scripts/check-sqlite-vaporetto.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.0",
    "tsx": "^4.20.0"
  }
}
